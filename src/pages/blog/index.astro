---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Aura from '../../components/ui/Aura.astro';
import Reveal from '../../islands/Reveal';
import Contact from '../../components/sections/Contact.astro';
import posts from '../../data/blogPosts.json';
const list = [...(posts as any[])].sort((a, b) => (b.date || '').localeCompare(a.date || ''));
const fmt = (d: string) => d ? new Date(d + 'T00:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
---
<PageLayout title="Blog & Articles | Sellwood Medical Clinic" description="Health tips and news for families from the pediatricians and providers at Sellwood Medical Clinic in Portland and Beaverton.">
  <PageHero eyebrow="Blog" title="Health tips for your family." intro="Simple, trusted advice from our care team." crumbs={[{ label: 'Blog' }]} />
  <section class="relative overflow-hidden bg-cream px-5 py-20 md:px-10 md:py-28">
    <Aura tone="light" rich leaves={false} />
    <div class="relative z-10 mx-auto grid max-w-[1400px] gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {list.map((p, i) => (
        <Reveal client:visible delay={(i % 3) * 0.07}>
          <a href={`/blog/${p.slug}/`} class="group flex h-full flex-col overflow-hidden rounded-3xl bg-white/80 shadow-[0_30px_60px_-35px_rgba(36,48,16,.5)] transition-all duration-500 hover:-translate-y-2">
            <div class="aspect-[16/10] overflow-hidden bg-gradient-to-br from-forest to-olive">
              {p.image && <img src={p.image} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />}
            </div>
            <div class="flex flex-1 flex-col p-6">
              <p class="text-xs font-semibold uppercase tracking-[.2em] text-olive">{[p.category, fmt(p.date)].filter(Boolean).join(' · ')}</p>
              <h2 class="mt-3 font-display text-xl leading-snug text-forest">{p.title}</h2>
              <p class="mt-3 text-sm leading-relaxed text-ink/70">{p.excerpt}</p>
              <span class="mt-auto inline-flex pt-5"><span class="btn btn-sm btn-line">Read more <span class="arrow">→</span></span></span>
            </div>
          </a>
        </Reveal>
      ))}
    </div>
  </section>
  <Contact />
</PageLayout>
