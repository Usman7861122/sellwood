---
import PageLayout from '../layouts/PageLayout.astro';
import Reveal from '../islands/Reveal';
import CountUp from '../islands/CountUp';
import Aura from '../components/ui/Aura.astro';
import Achievements from '../components/sections/Achievements.astro';
import Locations from '../components/sections/Locations.astro';
import Contact from '../components/sections/Contact.astro';
import { images } from '../data/images';
import { site } from '../data/site';

const pillars = [
  { t: 'A welcoming place', d: 'A safe, welcoming and affirming environment for every child and family.' },
  { t: 'A diverse team', d: 'We work to employ a diverse team of healthcare professionals.' },
  { t: 'Culturally aware care', d: 'We use culturally sensitive practices in everything we do.' },
  { t: 'Always learning', d: 'We keep educating ourselves so we can serve our community better.' },
];
const facts = [
  { to: 4, suffix: '', label: 'Locations in Portland and Beaverton' },
  { to: 23, suffix: '+', label: 'Years caring for local families' },
  { to: 0, text: 'Every age', label: 'From newborns to grandparents' },
];
---
<PageLayout
  title="About Sellwood Medical Clinic | Family Doctors in Portland, OR"
  description="Sellwood Medical Clinic is a well-loved family medicine and pediatric practice with four locations in Portland and Beaverton, Oregon."
>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-gradient-to-br from-forest via-forest to-ink px-5 pb-24 pt-44 text-cream md:px-10 md:pb-32 md:pt-56">
    <Aura tone="dark" rich />
    <div class="relative z-10 mx-auto grid max-w-[1400px] items-center gap-12 lg:grid-cols-[1.2fr_1fr]">
      <div>
      <Reveal client:load><nav class="text-xs uppercase tracking-[.2em] text-cream/60" aria-label="Breadcrumb"><a href="/" class="transition-colors hover:text-sprout">Home</a> <span class="mx-2">/</span> <span class="text-cream">About us</span></nav></Reveal>
      <Reveal client:load delay={0.1}>
        <h1 class="mt-8 max-w-4xl font-display text-5xl leading-[1.05] md:text-7xl">About <em class="text-sprout">Sellwood</em> Medical Clinic</h1>
      </Reveal>
      <Reveal client:load delay={0.2}>
        <p class="mt-8 max-w-2xl text-lg leading-relaxed text-cream/75 md:text-xl">Trusted family and pediatric care in Portland and Beaverton, with kind, patient-focused service across four locations.</p>
      </Reveal>
      </div>
      <Reveal client:load kind="mask">
        <div class="overflow-hidden rounded-3xl shadow-[0_50px_100px_-40px_rgba(0,0,0,.7)] ring-1 ring-cream/15">
          <img src={images.building} alt="" class="aspect-[5/4] w-full object-cover transition-transform duration-[1200ms] hover:scale-105" />
        </div>
      </Reveal>
    </div>
  </section>

  <!-- WHO WE ARE -->
  <section class="relative overflow-hidden bg-cream px-5 py-28 md:px-10 md:py-40">
    <Aura tone="light" />
    <div class="relative z-10 mx-auto grid max-w-[1400px] items-center gap-16 lg:grid-cols-2">
      <div>
        <Reveal client:visible><p class="eyebrow text-olive">Who we are</p></Reveal>
        <Reveal client:visible delay={0.1}>
          <h2 class="mt-6 font-display text-4xl leading-[1.1] text-forest md:text-6xl">Well-loved. <em class="text-maroon">Compassionate.</em> Part of the community.</h2>
        </Reveal>
        <Reveal client:visible delay={0.2}>
          <p class="mt-8 text-lg leading-relaxed text-ink/75">Sellwood Medical Clinic is an established, flourishing, and well-loved family medicine and pediatric care practice with four locations in the greater Portland Metro area. The practice focuses on providing compassionate, patient-oriented health care, making them an integral part of the medical field in the community.</p>
          <p class="mt-5 leading-relaxed text-ink/70">Sellwood Medical Clinic is proud of its diverse group of practitioners with a range of training, experience, and specialties. As a team, they provide expert family medical care as well as award-winning pediatric care, ensuring all of your family members, from newborns to grandparents, get the caring and professional medical attention that they deserve. We also provide gynecological services for women’s health. The team focuses on building long-term relationships with their patients to provide preventive care as well as timely care for unexpected injuries or illnesses.</p>
        </Reveal>
        <Reveal client:visible delay={0.3}>
          <div class="mt-10 flex flex-wrap gap-3">
            <a href={site.bookingUrl} class="btn btn-dark">Book a visit <span class="arrow">→</span></a>
            <a href={site.phoneHref} class="btn btn-line">Call {site.phone}</a>
          </div>
        </Reveal>
      </div>
      <Reveal client:visible kind="mask">
        <div class="overflow-hidden rounded-3xl shadow-[0_50px_100px_-40px_rgba(36,48,16,.55)]">
          <img src={images.aboutPage.who} alt="A caring doctor with a young patient" loading="lazy" class="aspect-[4/3] w-full object-cover transition-transform duration-[1200ms] ease-out hover:scale-[1.04]" />
        </div>
      </Reveal>
    </div>
  </section>

  <!-- FACTS -->
  <section class="relative overflow-hidden bg-forest px-5 py-20 text-cream md:px-10">
    <Aura tone="dark" rich leaves={false} />
    <div class="relative z-10 mx-auto grid max-w-[1400px] gap-10 text-center md:grid-cols-3">
      {facts.map((f, i) => (
        <Reveal client:visible delay={i * 0.1}>
          <p class="font-display text-6xl text-sprout md:text-7xl">{'text' in f && f.text ? f.text : <CountUp client:visible to={f.to} suffix={f.suffix} />}</p>
          <p class="mt-3 text-sm uppercase tracking-[.2em] text-cream/65">{f.label}</p>
        </Reveal>
      ))}
    </div>
  </section>

  <!-- ACCESSIBLE CARE -->
  <section class="relative overflow-hidden bg-sand px-5 py-24 md:px-10 md:py-32">
    <div class="relative z-10 mx-auto max-w-3xl text-center">
      <Reveal client:visible><p class="eyebrow text-olive">Accessible, convenient care</p></Reveal>
      <Reveal client:visible delay={0.1}><h2 class="mt-6 font-display text-4xl leading-[1.1] text-forest md:text-5xl">Four locations, <em class="text-maroon">easy to reach.</em></h2></Reveal>
      <Reveal client:visible delay={0.2}><p class="mt-8 text-lg leading-relaxed text-ink/75">Sellwood Medical Clinic has four locations, two in Portland’s Sellwood neighborhood, one in North Portland, and one in Beaverton, making it easy for your family to access the care they need in a convenient manner.</p></Reveal>
    </div>
  </section>
  <Locations />

  <Achievements />

  <!-- DEI -->
  <section class="relative overflow-hidden bg-cream px-5 py-28 md:px-10 md:py-40">
    <Aura tone="light" rich leaves={false} />
    <div class="relative z-10 mx-auto grid max-w-[1400px] items-center gap-16 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <Reveal client:visible><p class="eyebrow text-olive">Diversity, equity &amp; inclusion</p></Reveal>
        <Reveal client:visible delay={0.1}><h2 class="mt-6 font-display text-4xl leading-[1.1] text-forest md:text-6xl">Our commitment to <em class="text-maroon">everyone.</em></h2></Reveal>
        <Reveal client:visible delay={0.2}>
          <p class="mt-8 text-lg leading-relaxed text-ink/75">At Sellwood Medical Clinic, we are committed to promoting diversity, equity, and inclusivity (DEI) in all aspects of our practice. We firmly believe that every child and family should receive the highest standard of care, regardless of their race, ethnicity, religion, gender identity, sexual orientation, socioeconomic background, or any other characteristic.</p>
          <p class="mt-5 leading-relaxed text-ink/70">Our DEI values guide our policies, ensuring that we provide a safe, welcoming, and affirming environment for all. We strive to employ a diverse team of healthcare professionals, implement culturally sensitive practices, and continuously educate ourselves to better serve our diverse community. By embracing DEI, we aim to cultivate a healthcare setting where everyone feels valued, understood, and empowered to thrive.</p>
        </Reveal>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {pillars.map((p, i) => (
          <Reveal client:visible kind="zoom" delay={i * 0.1}>
            <div class="h-full rounded-3xl border border-forest/10 bg-white/70 p-7 backdrop-blur transition-all duration-500 hover:-translate-y-2 hover:bg-white hover:shadow-[0_30px_60px_-25px_rgba(36,48,16,.5)]">
              <span class="font-display text-3xl text-maroon">0{i + 1}</span>
              <h3 class="mt-4 font-display text-2xl text-forest">{p.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/70">{p.d}</p>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <Contact />
</PageLayout>
