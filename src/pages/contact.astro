---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Aura from '../components/ui/Aura.astro';
import Contact from '../components/sections/Contact.astro';
import { officeLocations, site } from '../data/site';
const offices = officeLocations.map((o) => ({ ...o, q: encodeURIComponent(`${o.address}, ${o.city}`) }));
---
<PageLayout title="Contact Us | Sellwood Medical Clinic in Portland, OR" description="Call, message or visit Sellwood Medical Clinic. Offices in Sellwood, North Portland and Beaverton, Oregon.">
  <PageHero eyebrow="Contact" title="We are here to help." intro="Call us, send a message, or visit one of our offices in Portland and Beaverton." crumbs={[{ label: 'Contact' }]}>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={site.phoneHref} class="btn btn-primary">Call {site.phone}</a>
      <a href={site.portalUrl} target="_blank" rel="noopener" class="btn btn-ghost">Patient Portal</a>
    </div>
  </PageHero>
  <section class="relative overflow-hidden bg-cream px-5 py-20 md:px-10 md:py-28">
    <Aura tone="light" rich leaves={false} />
    <div class="relative z-10 mx-auto max-w-[1400px]">
      <h2 class="font-display text-4xl text-forest md:text-5xl">Our offices</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {offices.map((o) => (
          <div class="rounded-3xl bg-white/80 p-7 shadow-[0_30px_60px_-35px_rgba(36,48,16,.5)]">
            <h3 class="font-display text-2xl text-forest">{o.full}</h3>
            <p class="mt-3 text-ink/75">{o.address}<br />{o.city}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              <a href={`https://www.google.com/maps/search/?api=1&query=${o.q}`} target="_blank" rel="noopener" class="btn btn-line">Directions</a>
              <a href={site.phoneHref} class="btn btn-dark">Call</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <Contact />
</PageLayout>
