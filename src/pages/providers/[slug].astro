---
import PageLayout from '../../layouts/PageLayout.astro';
import Reveal from '../../islands/Reveal';
import Aura from '../../components/ui/Aura.astro';
import Contact from '../../components/sections/Contact.astro';
import { images } from '../../data/images';
import { providerPages, bookLabel } from '../../data/providerPages';
import { officeLocations, services, site } from '../../data/site';

export function getStaticPaths() {
  return providerPages.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const first = p.name.split(' ')[0];
const last = p.name.split(' ').slice(-1)[0];
const locs = p.locations.map((l) => ({ ...officeLocations.find((x) => x.slug === l.slug)!, bookingUrl: l.bookingUrl }));
const svc = p.services.map((t) => services.find((s) => s.title === t)!).filter(Boolean);
const q = (l: { address: string; city: string }) => encodeURIComponent(`${l.address}, ${l.city}`);
---
<PageLayout title={p.title} description={p.description} image={p.photo}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-gradient-to-br from-forest via-forest to-ink px-5 pb-24 pt-40 text-cream md:px-10 md:pb-32 md:pt-48">
    <Aura tone="dark" rich />
    <div class="relative z-10 mx-auto grid max-w-[1400px] items-center gap-12 lg:grid-cols-[1.2fr_1fr]">
      <div>
        <Reveal client:load>
          <nav class="text-xs uppercase tracking-[.2em] text-cream/60" aria-label="Breadcrumb">
            <a href="/" class="hover:text-sprout">Home</a><span class="mx-2">/</span><a href="/providers/" class="hover:text-sprout">Providers</a><span class="mx-2">/</span><span class="text-cream">{p.name}</span>
          </nav>
        </Reveal>
        <Reveal client:load delay={0.1}><p class="eyebrow mt-10 text-sprout">{p.role}</p></Reveal>
        <Reveal client:load delay={0.15}>
          <h1 class="mt-5 font-display text-5xl leading-[1.05] md:text-7xl">{first} <em class="text-sprout">{last}</em>, {p.creds}</h1>
        </Reveal>
        <Reveal client:load delay={0.25}>
          <p class="mt-8 max-w-xl text-lg leading-relaxed text-cream/80">{p.tagline}</p>
        </Reveal>
        <Reveal client:load delay={0.35}>
          <div class="mt-10 flex flex-wrap gap-3">
            {p.locations.map((l, i) => <a href={l.bookingUrl} target="_blank" rel="noopener" class={`btn ${i === 0 ? 'btn-primary' : 'btn-ghost'}`}>{bookLabel(l.slug, l.bookingUrl)} <span class="arrow">→</span></a>)}
            <a href={site.phoneHref} class="btn btn-ghost">Call {site.phone}</a>
          </div>
        </Reveal>
        <Reveal client:load delay={0.45}>
          <dl class="mt-12 grid max-w-3xl gap-4 sm:grid-cols-3">
            {p.facts.map((f, i) => (
              <div class="group relative cursor-default overflow-hidden rounded-2xl border border-cream/25 bg-cream/10 p-6 shadow-[0_20px_40px_-25px_rgba(0,0,0,.7)] backdrop-blur-md transition-all duration-500 hover:-translate-y-2 hover:border-sprout hover:bg-sprout/20">
                <span class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-sprout text-forest transition-transform duration-500 group-hover:rotate-6 group-hover:scale-110">
                  <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    {i === 0 && <><rect x="3.5" y="5" width="17" height="15" rx="2.5" /><path d="M3.5 10h17M8 3v4M16 3v4" /></>}
                    {i === 1 && <><circle cx="12" cy="9" r="5.5" /><path d="m8.8 13.5-1.3 7 4.5-2.4 4.5 2.4-1.3-7" /></>}
                    {i === 2 && <><path d="M6 3v6a4 4 0 0 0 8 0V3" /><path d="M10 13v2a4 4 0 0 0 8 0v-1.5" /><circle cx="18" cy="12" r="1.8" /></>}
                  </svg>
                </span>
                <dt class="text-[.7rem] font-semibold uppercase tracking-[.2em] text-sprout">{f.label}</dt>
                <dd class="mt-2 font-display text-2xl leading-snug text-cream">{f.value}</dd>
                <span class="absolute inset-x-0 bottom-0 h-1 origin-left scale-x-0 bg-sprout transition-transform duration-700 group-hover:scale-x-100"></span>
              </div>
            ))}
          </dl>
        </Reveal>
      </div>
      <Reveal client:load kind="mask">
        <div class="overflow-hidden rounded-3xl shadow-[0_50px_100px_-40px_rgba(0,0,0,.7)]">
          <img src={p.photo} alt={`${p.name}, ${p.creds}`} class="aspect-[4/5] w-full object-cover object-top" />
        </div>
      </Reveal>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="relative overflow-hidden bg-cream px-5 py-24 md:px-10 md:py-36">
    <Aura tone="light" />
    <div class="relative z-10 mx-auto max-w-3xl">
      <Reveal client:visible><p class="eyebrow text-olive">About {p.callName}</p></Reveal>
      <Reveal client:visible delay={0.1}><h2 class="mt-6 font-display text-4xl leading-[1.1] text-forest md:text-5xl">Lasting relationships with <em class="text-maroon">every family.</em></h2></Reveal>
      <Reveal client:visible delay={0.2}>
        {p.bio.map((t) => <p class="mt-6 text-lg leading-relaxed text-ink/75">{t}</p>)}
      </Reveal>
    </div>
  </section>

  <!-- LOCATIONS -->
  <section id="locations" class="relative overflow-hidden bg-sand px-5 py-24 md:px-10 md:py-32">
    <div class="relative z-10 mx-auto max-w-[1400px]">
      <Reveal client:visible><p class="eyebrow text-olive">Where to see {p.callName}</p></Reveal>
      <Reveal client:visible delay={0.1}><h2 class="mt-6 max-w-3xl font-display text-4xl leading-[1.1] text-forest md:text-6xl">{locs.length === 1 ? 'One office' : 'Offices'}, <em class="text-maroon">close to you.</em></h2></Reveal>
      <div class="mt-12 grid gap-8">
        {locs.map((l) => (
          <Reveal client:visible>
            <div class="grid overflow-hidden rounded-3xl border border-forest/10 bg-cream shadow-[0_40px_80px_-40px_rgba(36,48,16,.45)] lg:grid-cols-[1fr_1.3fr]">
              <div class="p-8 md:p-12">
                <p class="text-xs uppercase tracking-[.2em] text-olive">{l.care}</p>
                <h3 class="mt-3 font-display text-3xl text-forest md:text-4xl">{l.full}</h3>
                <p class="mt-6 text-ink/75">{l.address}<br />{l.city}</p>
                <p class="mt-4"><a href={site.phoneHref} class="font-display text-2xl text-forest hover:text-olive">{site.phone}</a></p>
                <div class="mt-8 flex flex-wrap gap-3">
                  <a href={l.bookingUrl} target="_blank" rel="noopener" class="btn btn-dark">Book here</a>
                  <a href={`https://www.google.com/maps/search/?api=1&query=${q(l)}`} target="_blank" rel="noopener" class="btn btn-line">Directions</a>
                </div>
              </div>
              <iframe title={`Map of ${l.full}`} src={`https://www.google.com/maps?q=${q(l)}&output=embed`} loading="lazy" class="h-72 w-full border-0 lg:h-full lg:min-h-[340px]" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="services" class="relative overflow-hidden bg-forest px-5 py-24 text-cream md:px-10 md:py-32">
    <Aura tone="dark" rich leaves={false} />
    <div class="relative z-10 mx-auto max-w-[1400px]">
      <Reveal client:visible><p class="eyebrow text-sprout">Services {p.callName} offers</p></Reveal>
      <Reveal client:visible delay={0.1}><h2 class="mt-6 max-w-3xl font-display text-4xl leading-[1.1] md:text-6xl">{p.kind === 'ped' ? <>Care for your child, <em class="text-sprout">start to teen.</em></> : <>Care for you, <em class="text-sprout">at every stage.</em></>}</h2></Reveal>
      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {svc.map((s, i) => (
          <Reveal client:visible kind="zoom" delay={i * 0.08}>
            <a href={s.href} class="group block h-full overflow-hidden rounded-3xl border border-cream/15 bg-cream/5 backdrop-blur transition-all duration-500 hover:-translate-y-2 hover:bg-cream/10">
              <div class="aspect-[4/3] overflow-hidden"><img src={images.services[s.img]} alt={s.title} loading="lazy" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" /></div>
              <div class="p-6">
                <h3 class="font-display text-xl">{s.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-cream/70">{s.text}</p>
              </div>
            </a>
          </Reveal>
        ))}
      </div>
      <Reveal client:visible delay={0.2}>
        <ul class="mt-12 flex flex-wrap gap-3">
          {p.extraServices.map((t) => <li class="rounded-xl border border-cream/20 px-4 py-2 text-sm text-cream/80 transition-colors hover:border-sprout hover:text-sprout">{t}</li>)}
        </ul>
      </Reveal>
    </div>
  </section>

  <Contact />
</PageLayout>
