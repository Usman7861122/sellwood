---
import Reveal from '../../islands/Reveal';
import { images } from '../../data/images';
import { posts, site } from '../../data/site';
---
<section id="blog" class="relative overflow-hidden bg-cream px-5 py-28 md:px-10 md:py-36">
  <div class="relative z-10 mx-auto max-w-[1400px]">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <div>
        <Reveal client:visible><p class="eyebrow text-olive">Our blog</p></Reveal>
        <Reveal client:visible delay={0.1}><h2 class="mt-6 font-display text-4xl leading-[1.1] text-forest md:text-6xl">Helpful reading for <em class="text-maroon">busy parents.</em></h2></Reveal>
      </div>
      <Reveal client:visible delay={0.2}><a href={`${site.old}/articles/`} class="btn btn-line">All articles <span class="arrow">→</span></a></Reveal>
    </div>
    <div class="mt-16 grid gap-8 md:grid-cols-3">
      {posts.map((p, i) => (
        <Reveal client:visible delay={i * 0.12}>
          <a href={p.href} class="group block">
            <div class="aspect-[4/3] overflow-hidden rounded-3xl">
              <img src={images.blog[p.img]} alt="" loading="lazy" class="h-full w-full object-cover transition-transform duration-[1200ms] group-hover:scale-110" />
            </div>
            <h3 class="mt-6 font-display text-2xl leading-snug text-forest transition-colors duration-300 group-hover:text-olive">{p.title}</h3>
            <span class="mt-4 inline-flex"><span class="btn btn-sm btn-line">Learn more <span class="arrow">→</span></span></span>
          </a>
        </Reveal>
      ))}
    </div>
  </div>
</section>
