---
import Reveal from '../../islands/Reveal';
import LocationsPicker from '../../islands/Locations';
import { images } from '../../data/images';
---
<section id="locations" class="relative overflow-hidden px-5 py-28 text-cream md:px-10 md:py-36">
  <img src={images.skyline} alt="Portland skyline across the river" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
  <div class="absolute inset-0 bg-gradient-to-b from-ink/90 via-forest/85 to-ink/95"></div>
  <div class="relative z-10 mx-auto max-w-[1400px]">
    <Reveal client:visible><p class="eyebrow text-sprout">Our locations</p></Reveal>
    <Reveal client:visible delay={0.1}><h2 class="mt-6 max-w-3xl font-display text-4xl leading-[1.1] md:text-6xl">Four offices, <em class="text-sprout">always close.</em></h2></Reveal>
    <div class="mt-14"><LocationsPicker client:visible /></div>
  </div>
</section>
