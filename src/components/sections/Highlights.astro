---
import Reveal from '../../islands/Reveal';
import CountUp from '../../islands/CountUp';
import { highlights } from '../../data/site';
---
<section id="highlights" class="relative z-20 -mt-24 px-5 md:px-10">
  <div class="mx-auto grid max-w-[1400px] gap-px overflow-hidden rounded-3xl bg-white/10 shadow-[0_40px_80px_-30px_rgba(17,23,10,.6)] backdrop-blur-xl sm:grid-cols-2 lg:grid-cols-4">
    {highlights.map((h, i) => (
      <Reveal client:visible kind="up" delay={i * 0.1} className="group relative overflow-hidden bg-forest p-8 text-cream transition-colors duration-500 hover:bg-moss">
        <span class="absolute left-0 top-0 h-full w-[3px] origin-top scale-y-0 bg-gradient-to-b from-sprout to-maroon transition-transform duration-700 group-hover:scale-y-100"></span>
        <p class="font-display text-5xl text-sprout md:text-6xl">
          {'text' in h && h.text ? h.text : <CountUp client:visible to={h.value} suffix={h.suffix} />}
        </p>
        <p class="mt-3 max-w-[18rem] text-sm leading-relaxed text-cream/75">{h.label}</p>
      </Reveal>
    ))}
  </div>
</section>
