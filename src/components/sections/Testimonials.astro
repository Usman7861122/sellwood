---
import Reveal from '../../islands/Reveal';
import TestimonialSlider from '../../islands/Testimonials';
import { testimonials, site } from '../../data/site';
---
<section id="testimonials" class="relative overflow-hidden bg-ink px-5 py-32 md:px-10 md:py-44">
  <div class="relative z-10 mx-auto max-w-[1400px] text-center">
    <Reveal client:visible><p class="eyebrow text-sprout">Testimonials</p></Reveal>
    <div class="mt-16"><TestimonialSlider client:visible items={testimonials} /></div>
    <Reveal client:visible delay={0.2}>
      <a href={`${site.old}/testimonials/`} class="btn btn-ghost mt-14">View more testimonials <span class="arrow">→</span></a>
    </Reveal>
  </div>
</section>
