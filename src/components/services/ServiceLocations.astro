---
import Reveal from '../../islands/Reveal';
import Aura from '../ui/Aura.astro';
import { site, type ServiceLocation } from '../../data/site';

interface Props { base: string; serviceName: string; locations: ServiceLocation[]; current?: string }
const { base, serviceName, locations, current } = Astro.props;
const active = locations.find((l) => l.slug === current);
const count = ['no', 'one', 'two', 'three', 'four', 'five'][locations.length] ?? String(locations.length);
const cols = locations.length >= 4 ? 'md:grid-cols-2 xl:grid-cols-4' : 'md:grid-cols-3';
const q = active ? encodeURIComponent(`${active.address}, ${active.city}`) : '';
---
<section id="service-locations" class="relative overflow-hidden bg-cream px-5 py-24 md:px-10 md:py-32">
  <Aura tone="light" />
  <div class="relative z-10 mx-auto max-w-[1400px]">
    <Reveal client:visible><p class="eyebrow text-olive">Where we offer it</p></Reveal>
    <Reveal client:visible delay={0.1}>
      <h2 class="mt-6 max-w-3xl font-display text-4xl leading-[1.1] text-forest md:text-6xl">
        {active ? <>{serviceName} in <em class="text-maroon">{active.label}.</em></> : <>{serviceName} at <em class="text-maroon">{locations.length === 1 ? 'our office.' : `${count} locations.`}</em></>}
      </h2>
    </Reveal>
    <Reveal client:visible delay={0.2}>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink/70">
        {active ? (locations.length > 1 ? 'Visit this office, or choose another location below.' : 'Visit this office.') : (locations.length === 1 ? 'See the details for this office.' : 'Choose the office closest to you to see the details for that location.')}
      </p>
    </Reveal>

    {active && (
      <Reveal client:visible kind="up">
        <div class="mt-12 grid overflow-hidden rounded-3xl border border-forest/10 bg-white/70 shadow-[0_40px_80px_-40px_rgba(36,48,16,.45)] backdrop-blur lg:grid-cols-[1fr_1.3fr]">
          <div class="p-8 md:p-12">
            <p class="text-xs uppercase tracking-[.2em] text-olive">{active.care}</p>
            <h3 class="mt-3 font-display text-3xl text-forest md:text-4xl">{active.full}</h3>
            <p class="mt-6 text-ink/75">{active.address}<br />{active.city}</p>
            <p class="mt-4"><a href={site.phoneHref} class="font-display text-2xl text-forest hover:text-olive">{site.phone}</a></p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href={site.portalUrl} target="_blank" rel="noopener" class="btn btn-dark">Patient Portal</a>
              <a href={`https://www.google.com/maps/search/?api=1&query=${q}`} target="_blank" rel="noopener" class="btn btn-line">Directions</a>
            </div>
          </div>
          <iframe title={`Map of ${active.full}`} src={`https://www.google.com/maps?q=${q}&output=embed`} loading="lazy" class="h-72 w-full border-0 lg:h-full lg:min-h-[360px]" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </Reveal>
    )}

    <div class={`grid gap-5 ${cols} ${active ? 'mt-10' : 'mt-14'}`}>
      {locations.filter((l) => l.slug !== current).map((l, i) => (
        <Reveal client:visible kind="zoom" delay={i * 0.1}>
          <a href={`${base}${l.slug}/`} class="group flex h-full flex-col rounded-3xl border border-forest/10 bg-white/70 p-8 backdrop-blur transition-all duration-500 hover:-translate-y-2 hover:bg-white hover:shadow-[0_30px_60px_-25px_rgba(36,48,16,.5)]">
            <span class="text-xs uppercase tracking-[.2em] text-olive">{l.care}</span>
            <h3 class="mt-3 font-display text-2xl text-forest">{l.label}</h3>
            <p class="mt-1 text-sm text-ink/60">{l.full}</p>
            <p class="mt-5 text-sm leading-relaxed text-ink/75">{l.address}<br />{l.city}</p>
            <p class="mt-2 text-sm text-ink/75">{site.phone}</p>
            <span class="mt-auto inline-flex pt-6"><span class="btn btn-sm btn-line">View this location <span class="arrow">→</span></span></span>
          </a>
        </Reveal>
      ))}
    </div>
    {active && <p class="mt-8"><a href={base} class="btn btn-sm btn-line">← All locations</a></p>}
  </div>
</section>
