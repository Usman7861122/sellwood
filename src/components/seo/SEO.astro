---
import { site } from '../../data/site';
import { locationPages } from '../../data/locationPages';

interface Props { title: string; description?: string; image?: string; noindex?: boolean; type?: 'website' | 'article'; jsonld?: object[] }
const { title: rawTitle, description: rawDescription = '', image, noindex = false, type = 'website', jsonld = [] } = Astro.props;

// Search-friendly lengths: title 30-60, description 120-155 (the build fails if a page is outside).
const BRAND = 'Sellwood Medical Clinic';
const cut = (s: string, max: number) => {
  if (s.length <= max) return s;
  const t = s.slice(0, max - 1);
  return t.slice(0, Math.max(t.lastIndexOf(' '), 20)).replace(/[\s,:;–-]+$/, '') + '…';
};
const fitTitle = (t: string) => {
  t = t.trim();
  const short = 'Sellwood Medical';
  const main = t.split(' | ')[0];
  const options = [t, t.replace(BRAND, short), `${main} | ${BRAND}`, `${main} | ${short}`, main];
  const ok = options.find((c) => c.length >= 30 && c.length <= 60);
  if (ok) return ok;
  return main.length > 60 ? cut(main, 60) : `${main} | ${short}`.length <= 60 ? `${main} | ${short}` : main;
};
const fitDescription = (d: string) => {
  d = d.trim().replace(/\s+/g, ' ');
  if (!d) return d;
  if (d.length > 155) {
    d = d.replace(/\s*(Offered at|Located at|Visit us at)[^.]*\.?$/i, '').trim();
    if (d.length > 155) {
      const sentences = d.match(/[^.!?]+[.!?]+/g) ?? [];
      let acc = '';
      for (const x of sentences) { if ((acc + x).trim().length <= 155) acc += x; else break; }
      d = acc.trim().length >= 120 ? acc.trim() : cut(d, 155);
    }
  }
  const adds = [' Call 503-595-9300 or book online.', /Beaverton|Portland/.test(d) ? ' Most insurance accepted.' : ' Serving Portland and Beaverton, OR.'];
  for (const add of adds) {
    if (d.length < 120 && (d + add).length <= 155) d += add;
  }
  return d;
};
const title = fitTitle(rawTitle);
const description = fitDescription(rawDescription);
const base = site.url;
const canonical = new URL(Astro.url.pathname, base).href;
const abs = (u: string) => (u.startsWith('http') ? u : new URL(u, base).href);
const ogImage = abs(image ?? '/images/og-default.jpg');

const place = (c: string) => {
  const m = c.match(/^(.*),\s*([A-Z]{2})\s+(\d{5})/);
  return m ? { addressLocality: m[1], addressRegion: m[2], postalCode: m[3] } : {};
};
const clinic = {
  '@context': 'https://schema.org',
  '@type': ['MedicalClinic', 'Pediatric'],
  '@id': `${base}/#clinic`,
  name: site.name,
  url: base + '/',
  description: site.description,
  telephone: '+1-503-595-9300',
  logo: abs('/images/sellwood-logo.png'),
  image: abs('/images/og-default.jpg'),
  priceRange: '$$',
  medicalSpecialty: ['Pediatric', 'PrimaryCare', 'Gynecologic'],
  sameAs: [site.social.facebook, site.social.instagram],
  areaServed: ['Portland, OR', 'Beaverton, OR'],
  department: locationPages.map((l) => ({
    '@type': 'MedicalClinic',
    name: `${site.name} – ${l.name}`,
    url: `${base}/locations/${l.slug}/`,
    telephone: '+1-503-595-9300',
    address: { '@type': 'PostalAddress', streetAddress: l.address, addressCountry: 'US', ...place(l.city) },
  })),
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${base}/#website`, name: site.name, url: base + '/', publisher: { '@id': `${base}/#clinic` } };
const graph = Astro.url.pathname === '/' ? [clinic, website, ...jsonld] : [clinic, ...jsonld];
---
<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:image" content={ogImage} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={ogImage} />
{graph.map((g) => <script type="application/ld+json" set:html={JSON.stringify(g)} />)}
