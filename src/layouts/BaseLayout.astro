---
import '../styles/global.css';
import CookieConsent from '../islands/CookieConsent';
import SEO from '../components/seo/SEO.astro';

interface Props { title: string; description?: string; image?: string; noindex?: boolean }
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#11170a" />
    <link rel="icon" type="image/png" href="/images/logo.png" />
    <link rel="preload" href="/fonts/playfair-display-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <SEO {...Astro.props} />
  </head>
  <body>
    <slot />
    <CookieConsent client:idle />
  </body>
</html>
